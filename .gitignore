*.aab
*.apk
*.ipa

# Signing certs / keys — SENSITIVE, never commit
*.pem
*.p8
*.p12
*.keystore
*.jks
*.mobileprovision

# Local working folders
Graphics/

# Raw device screenshots used to compose store graphics (source material)
docs/store-assets/raw/*.PNG
docs/store-assets/raw/*.png
